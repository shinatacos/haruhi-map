{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Route Notebook itinerary patch v1",
  "type": "object",
  "required": ["kind", "version", "points", "events"],
  "properties": {
    "kind": {"const": "route-notebook-itinerary"},
    "version": {"const": 1},
    "trips": {"type": "array", "items": {"$ref": "#/$defs/trip"}},
    "points": {"type": "array", "items": {"$ref": "#/$defs/point"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "row": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "tripId": {"type": "string", "minLength": 1}}},
    "trip": {"allOf": [{"$ref": "#/$defs/row"}], "properties": {"title": {"type": "string"}, "startDate": {"type": "string", "format": "date"}, "endDate": {"type": "string", "format": "date"}, "budget": {"type": "number", "minimum": 0}, "note": {"type": "string"}}},
    "point": {"allOf": [{"$ref": "#/$defs/row"}], "properties": {"name": {"type": "string", "minLength": 1}, "lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}, "source": {"type": "string"}, "precision": {"type": "string"}}},
    "event": {"allOf": [{"$ref": "#/$defs/row"}], "properties": {"plan": {"type": "string", "minLength": 1}, "day": {"type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{1,2}/[0-9]{1,2})$"}, "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}, "action": {"type": "string", "minLength": 1}, "pointId": {"type": ["string", "null"]}, "confidence": {"type": "string"}, "source": {"type": "string"}, "travelMode": {"enum": ["unspecified", "walking", "transit", "hankyu", "jr", "hanshin", "subway", "bus", "driving", "bicycling"]}, "order": {"type": "number", "minimum": 0}, "stayMinutes": {"type": ["number", "null"], "minimum": 0}, "cost": {"type": ["number", "null"], "minimum": 0}}}
  }
}
